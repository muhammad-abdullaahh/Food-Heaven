@model IEnumerable<FoodHeaven.Models.Order>

@{
    ViewData["Title"] = "My Profile";
    var reservations = ViewBag.Reservations as List<FoodHeaven.Models.Reservation> ?? new List<FoodHeaven.Models.Reservation>();
}

<div class="min-h-screen bg-gray-50 dark:bg-[#0a0a0a] py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
        
        <!-- Header -->
        <div class="mb-12 border-b border-gray-200 dark:border-white/10 pb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <h1 class="text-4xl font-display font-black text-text-main dark:text-white mb-2">My Profile</h1>
                <p class="text-text-muted dark:text-gray-400">Manage your orders and reservations</p>
            </div>
            <div class="flex items-center gap-4 bg-white dark:bg-card-dark p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-white/5">
                <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-black font-bold text-xl">
                    @User.Identity.Name?.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <h3 class="font-bold text-text-main dark:text-white">@User.Identity.Name</h3>
                    <p class="text-sm text-text-muted">User ID: @ViewBag.UserId</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <!-- SECTION: ORDERS -->
            <div>
                <h2 class="text-2xl font-bold text-text-main dark:text-white mb-6 flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary text-3xl">receipt_long</span> 
                    Order History
                </h2>
                
                @if (!Model.Any())
                {
                    <div class="text-center py-12 bg-white dark:bg-card-dark rounded-3xl border border-gray-100 dark:border-white/5 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-gray-300 mb-4 block">fastfood</span>
                        <h3 class="text-lg font-bold text-text-main dark:text-white mb-2">No orders yet</h3>
                        <a href="/Menu" class="text-primary hover:text-primary-dark font-bold inline-flex items-center gap-1">Browse Menu <span class="material-symbols-outlined text-sm">arrow_forward</span></a>
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var order in Model)
                        {
                            <div class="bg-white dark:bg-card-dark rounded-[2rem] p-6 border border-gray-100 dark:border-white/5 shadow-lg relative overflow-hidden group">
                                <div class="absolute inset-0 bg-gradient-to-r from-transparent to-gray-50 dark:to-white/5 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                
                                <div class="flex justify-between items-start mb-4 relative z-10">
                                    <div>
                                        <div class="flex items-center gap-3 mb-1">
                                            <span class="text-lg font-bold text-text-main dark:text-white">@order.OrderNumber</span>
                                            @{
                                                var statusColor = "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400";
                                                if (order.Status == "Pending") statusColor = "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400";
                                                else if (order.Status == "Confirmed" || order.Status == "Preparing") statusColor = "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400";
                                                else if (order.Status == "Delivered" || order.Status == "Completed") statusColor = "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400";
                                                else if (order.Status == "Cancelled") statusColor = "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400";
                                            }
                                            <span class="px-3 py-1 rounded-full text-xs font-bold @statusColor">@order.Status</span>
                                        </div>
                                        <div class="text-sm text-text-muted">@order.OrderDate.ToString("MMM dd, yyyy • hh:mm tt")</div>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-xl font-black text-primary">@order.Total.ToString("C")</div>
                                        <div class="text-xs text-text-muted">@order.OrderItems.Count items</div>
                                    </div>
                                </div>

                                <div class="bg-gray-50 dark:bg-black/20 rounded-xl p-3 mb-4 relative z-10">
                                    <ul class="space-y-1">
                                        @foreach (var item in order.OrderItems.Take(2))
                                        {
                                            <li class="flex justify-between text-sm text-text-main dark:text-gray-300">
                                                <span><span class="font-bold text-primary">@item.Quantity x</span> @item.MenuItem.Name</span>
                                            </li>
                                        }
                                        @if (order.OrderItems.Count > 2)
                                        {
                                            <li class="text-xs text-text-muted italic pt-1">+ @(order.OrderItems.Count - 2) more</li>
                                        }
                                    </ul>
                                </div>

                                <a href="/Order/Confirmation/@order.Id" class="relative z-10 inline-flex items-center text-sm font-bold text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors">
                                    View Details <span class="material-symbols-outlined text-[16px] ml-1">arrow_forward</span>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- SECTION: RESERVATIONS -->
            <div>
                <h2 class="text-2xl font-bold text-text-main dark:text-white mb-6 flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary text-3xl">event_seat</span> 
                    Table Reservations
                </h2>
                
                @if (!reservations.Any())
                {
                    <div class="text-center py-12 bg-white dark:bg-card-dark rounded-3xl border border-gray-100 dark:border-white/5 shadow-sm">
                        <span class="material-symbols-outlined text-4xl text-gray-300 mb-4 block">event</span>
                        <h3 class="text-lg font-bold text-text-main dark:text-white mb-2">No reservations</h3>
                        <a href="/Reservation/Create" class="text-primary hover:text-primary-dark font-bold inline-flex items-center gap-1">Book a Table <span class="material-symbols-outlined text-sm">arrow_forward</span></a>
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var res in reservations)
                        {
                            var isCancelled = res.Status == "Cancelled";
                            <div id="res-card-@res.Id" class="bg-white dark:bg-card-dark rounded-[2rem] p-6 border border-gray-100 dark:border-white/5 shadow-lg transition-all @(isCancelled ? "opacity-60" : "")">
                                <div class="flex justify-between items-start mb-4 border-b border-gray-100 dark:border-white/5 pb-4">
                                    <div>
                                        <div class="flex items-center gap-3 mb-1">
                                            <span class="text-lg font-bold text-text-main dark:text-white">@res.ReservationDate.ToString("ddd, MMM dd")</span>
                                            
                                            @{
                                                var resStatusColor = isCancelled ? "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400" : "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400";
                                                if (res.Status == "Pending") resStatusColor = "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400";
                                            }
                                            <span id="res-status-@res.Id" class="px-3 py-1 rounded-full text-xs font-bold @resStatusColor">@res.Status</span>
                                        </div>
                                        <div class="text-sm text-primary font-bold">@DateTime.Today.Add(res.ReservationTime).ToString("hh:mm tt")</div>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-sm font-bold bg-gray-100 dark:bg-white/5 px-3 py-1 rounded-lg inline-block">@res.TableNumber</div>
                                        <div class="text-xs text-text-muted mt-1 uppercase tracking-wide">@res.ReservationType</div>
                                    </div>
                                </div>

                                <div class="flex gap-4 items-center">
                                    <div class="flex-1 flex gap-4 text-sm text-text-main dark:text-gray-300">
                                        <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px] text-gray-400">group</span> @res.PartySize Guests</span>
                                        <a href="/Reservation/Confirmation/@res.Id" class="font-bold text-primary hover:underline">View Ticket</a>
                                    </div>
                                    
                                    @if (!isCancelled)
                                    {
                                        <button id="cancel-res-btn-@res.Id" onclick="cancelReservation(@res.Id)" class="px-4 py-2 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-bold rounded-lg hover:bg-red-500 hover:text-white transition-colors">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function cancelReservation(id) {
            if(confirm("Are you sure you want to cancel this reservation?")) {
                let btn = document.getElementById('cancel-res-btn-' + id);
                let originalText = btn.innerText;
                btn.disabled = true;
                btn.innerText = "Cancelling...";

                fetch('/Reservation/Cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ 'id': id })
                })
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        let statusBadge = document.getElementById('res-status-' + id);
                        statusBadge.innerText = "Cancelled";
                        statusBadge.className = "px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400";
                        
                        document.getElementById('res-card-' + id).classList.add('opacity-60');
                        btn.style.display = 'none';
                    } else {
                        alert(data.message || 'Error cancelling reservation.');
                        btn.disabled = false;
                        btn.innerText = originalText;
                    }
                })
                .catch(err => {
                    alert('Network error.');
                    btn.disabled = false;
                    btn.innerText = originalText;
                });
            }
        }
    </script>
}
